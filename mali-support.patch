+// ---- The same question through Android hardware buffers (an Arm GPU, once at the device's start; log tag [ahb]) ----
+// A Mali driver that refuses its own exported memory (the buffer refused, or no file from vkGetMemoryFdKHR / a map that
+// fails: Mali-G720 r44p1) may still take memory Android's allocator made: an AHardwareBuffer (BLOB), imported as a Vulkan
+// buffer (VK_ANDROID_external_memory_android_hardware_buffer), its dma-buf mapped by mmap - what the allocator's own lock
+// does. Nothing here is used by the game: each size is allocated, tested and freed, and the log says what worked.
+#include <dlfcn.h>
+#include <errno.h>
+#include <sys/ioctl.h>
+
+typedef struct { uint32_t width, height, layers, format; uint64_t usage; uint32_t stride, rfu0; uint64_t rfu1; } ahb_desc;
+typedef struct { int version, numFds, numInts; int data[1]; } ahb_handle;  // (libcutils' native_handle_t: its layout is fixed)
+struct ahb_dma_sync { uint64_t flags; };
+#define AHB_FORMAT_BLOB 0x21u
+#define AHB_USAGE_CPU_OFTEN 0x33ull       // CPU_READ_OFTEN | CPU_WRITE_OFTEN
+#define AHB_USAGE_GPU_DATA_BUFFER (1ull << 24)
+#define AHB_DMA_BUF_IOCTL_SYNC _IOW('b', 0, struct ahb_dma_sync)
+#define AHB_SYNC_RW 3ull
+#define AHB_SYNC_START 0ull
+#define AHB_SYNC_END 4ull
+
+static void probe_ahb_size(void *lib, uint64_t size, bool full) {
+    int (*alloc)(const ahb_desc *, void **) = (int (*)(const ahb_desc *, void **))dlsym(lib, "AHardwareBuffer_allocate");
+    void (*rel)(void *) = (void (*)(void *))dlsym(lib, "AHardwareBuffer_release");
+    const ahb_handle *(*gnh)(const void *) = (const ahb_handle *(*)(const void *))dlsym(lib, "AHardwareBuffer_getNativeHandle");
+    unsigned mb = (unsigned)(size >> 20);
+    if (!alloc || !rel || !gnh) { LOG("[ahb] %u MB: libandroid lacks %s\n", mb, !alloc ? "allocate" : !rel ? "release" : "getNativeHandle (Android 12+)"); return; }
+    if (!vkGetAndroidHardwareBufferPropertiesANDROID) { LOG("[ahb] %u MB: the driver's function for hardware buffers is not loaded\n", mb); return; }
+    ahb_desc d = {.width = (uint32_t)size, .height = 1, .layers = 1, .format = AHB_FORMAT_BLOB,
+                  .usage = AHB_USAGE_CPU_OFTEN | AHB_USAGE_GPU_DATA_BUFFER};
+    void *hb = NULL;
+    int ar = alloc(&d, &hb);
+    if (ar != 0 || !hb) { LOG("[ahb] %u MB: the allocator refused (%d)\n", mb, ar); return; }
+    VkBuffer buf = VK_NULL_HANDLE, out = VK_NULL_HANDLE;
+    VkDeviceMemory mem = VK_NULL_HANDLE;
+    uint8_t *p = MAP_FAILED;
+    void *resv = MAP_FAILED;
+    const char *why = NULL;
+    VkAndroidHardwareBufferPropertiesANDROID ap = {.sType = VK_STRUCTURE_TYPE_ANDROID_HARDWARE_BUFFER_PROPERTIES_ANDROID};
+    VkResult r = vkGetAndroidHardwareBufferPropertiesANDROID(g_vk.dev, (struct AHardwareBuffer *)hb, &ap);
+    if (r != VK_SUCCESS) { why = "the driver's properties of the buffer"; goto done; }
+    VkExternalMemoryBufferCreateInfo eb = {.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO,
+                                           .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_ANDROID_HARDWARE_BUFFER_BIT_ANDROID};
+    VkBufferCreateInfo bci = {.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, .pNext = &eb, .size = size,
+                              .usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT |
+                                       VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_VERTEX_BUFFER_BIT |
+                                       VK_BUFFER_USAGE_INDEX_BUFFER_BIT | VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT};
+    r = vkCreateBuffer(g_vk.dev, &bci, NULL, &buf);
+    if (r != VK_SUCCESS) { LOG("[ahb] %u MB: the Vulkan buffer refused (%d); the hardware buffer takes memory types 0x%x\n", mb, r, ap.memoryTypeBits); goto done; }
+    VkMemoryRequirements mr;
+    vkGetBufferMemoryRequirements(g_vk.dev, buf, &mr);
+    VkPhysicalDeviceMemoryProperties mp;
+    vkGetPhysicalDeviceMemoryProperties(g_vk.phys, &mp);
+    uint32_t bits = ap.memoryTypeBits & mr.memoryTypeBits;
+    int type = -1;  // host-visible first (what a CPU map needs), coherent and cached preferred
+    for (uint32_t i = 0; i < mp.memoryTypeCount; i++) {
+        VkMemoryPropertyFlags f = mp.memoryTypes[i].propertyFlags;
+        if (!(bits & (1u << i)) || !(f & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)) continue;
+        if (type < 0 || (f & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) type = (int)i;
+    }
+    if (type < 0 && bits) type = __builtin_ctz(bits);
+    if (type < 0) { LOG("[ahb] %u MB: no memory type for it (hardware buffer 0x%x, buffer 0x%x)\n", mb, ap.memoryTypeBits, mr.memoryTypeBits); goto done; }
+    VkImportAndroidHardwareBufferInfoANDROID imp = {.sType = VK_STRUCTURE_TYPE_IMPORT_ANDROID_HARDWARE_BUFFER_INFO_ANDROID,
+                                                    .buffer = (struct AHardwareBuffer *)hb};
+    VkMemoryAllocateInfo mai = {.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, .pNext = &imp, .allocationSize = ap.allocationSize,
+                                .memoryTypeIndex = (uint32_t)type};
+    r = vkAllocateMemory(g_vk.dev, &mai, NULL, &mem);
+    if (r != VK_SUCCESS) { LOG("[ahb] %u MB: import refused (%d, type %d)\n", mb, r, type); goto done; }
+    r = vkBindBufferMemory(g_vk.dev, buf, mem, 0);
+    if (r != VK_SUCCESS) { LOG("[ahb] %u MB: bind refused (%d)\n", mb, r); goto done; }
+    const ahb_handle *h = gnh(hb);
+    if (!h || h->numFds < 1 || h->data[0] < 0) { LOG("[ahb] %u MB: imported (type %d, flags 0x%x), but no file in the buffer's handle (%d files)\n", mb, type, (unsigned)mp.memoryTypes[type].propertyFlags, h ? h->numFds : -1); goto done; }
+    int fd = h->data[0];  // (owned by the hardware buffer: not closed here)
+    p = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (p == MAP_FAILED) { LOG("[ahb] %u MB: imported (type %d, flags 0x%x), the file's mmap failed: errno %d\n", mb, type, (unsigned)mp.memoryTypes[type].propertyFlags, errno); p = MAP_FAILED; goto done; }
+    // at an address of our choosing, as the heap needs (over reserved pages, MAP_FIXED)
+    munmap(p, size);
+    p = MAP_FAILED;
+    resv = mmap(NULL, size, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    bool fixed = false;
+    if (resv != MAP_FAILED) {
+        p = mmap(resv, size, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_FIXED, fd, 0);
+        fixed = p == resv;
+        if (!fixed) p = MAP_FAILED;
+    }
+    if (!fixed) { LOG("[ahb] %u MB: imported (type %d), mmap works but not at a fixed address: errno %d\n", mb, type, errno); goto done; }
+    if (!full) { LOG("[ahb] %u MB: ok - allocated, imported (type %d, flags 0x%x), mapped at a fixed address\n", mb, type, (unsigned)mp.memoryTypes[type].propertyFlags); goto done; }
+    uint8_t *tmp = malloc(PROBE_SIZE);
+    if (!tmp) { why = "memory"; goto done; }
+    memset(tmp, 0x11, PROBE_SIZE);
+    double t0 = now_s();
+    for (int i = 0; i < 4; i++) memcpy(p, tmp, PROBE_SIZE);
+    double t1 = now_s();
+    volatile uint64_t sum = 0;
+    for (int i = 0; i < 4; i++) { memcpy(tmp, p, PROBE_SIZE); sum += tmp[i * 4096]; }
+    double t2 = now_s();
+    free(tmp);
+    double wr = 4.0 * PROBE_SIZE / (t1 - t0) / 1e9, rd = 4.0 * PROBE_SIZE / (t2 - t1) / 1e9;
+    // the GPU sees what the CPU wrote and the CPU what the GPU wrote (with the allocator's cache syncs around the GPU's work)
+    for (int i = 0; i < 4096; i++) p[i] = (uint8_t)(i * 7 + 3);
+    struct ahb_dma_sync sy = {AHB_SYNC_END | AHB_SYNC_RW};
+    int s1 = ioctl(fd, AHB_DMA_BUF_IOCTL_SYNC, &sy);
+    bool gpu_ok = false, gpu_sees = false, cpu_sees = false;
+    VkBufferCreateInfo vbi = bci;
+    vbi.size = 1u << 20;
+    if (vkCreateBuffer(g_vk.dev, &vbi, NULL, &out) == VK_SUCCESS && vkBindBufferMemory(g_vk.dev, out, mem, 8u << 20) == VK_SUCCESS)
+        gpu_ok = gpu_round(buf, out);
+    sy.flags = AHB_SYNC_START | AHB_SYNC_RW;
+    int s2 = ioctl(fd, AHB_DMA_BUF_IOCTL_SYNC, &sy);
+    if (gpu_ok) {
+        gpu_sees = true;
+        for (int i = 0; i < 4096 && gpu_sees; i++) gpu_sees = p[(8u << 20) + i] == (uint8_t)(i * 7 + 3);
+        cpu_sees = true;
+        for (int i = 0; i < 4096 && cpu_sees; i++) cpu_sees = p[(8u << 20) + 4096 + i] == 0x5a;
+    }
+    LOG("[ahb] %u MB: ok - allocated, imported (type %d, flags 0x%x%s%s), fixed-address map; CPU writes %.1f GB/s, reads %.1f GB/s; "
+        "the GPU %s the CPU's bytes, the CPU %s the GPU's (cache syncs rc %d/%d)\n", mb, type, (unsigned)mp.memoryTypes[type].propertyFlags,
+        mp.memoryTypes[type].propertyFlags & VK_MEMORY_PROPERTY_HOST_CACHED_BIT ? " cached" : "",
+        mp.memoryTypes[type].propertyFlags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT ? " coherent" : "", wr, rd,
+        !gpu_ok ? "(submission failed)" : gpu_sees ? "sees" : "does NOT see", !gpu_ok ? "-" : cpu_sees ? "sees" : "does NOT see", s1, s2);
+done:
+    if (why) LOG("[ahb] %u MB: failed at %s\n", mb, why);
+    if (p != MAP_FAILED) munmap(p, size);
+    else if (resv != MAP_FAILED) munmap(resv, size);
+    if (out) vkDestroyBuffer(g_vk.dev, out, NULL);
+    if (buf) vkDestroyBuffer(g_vk.dev, buf, NULL);
+    if (mem) vkFreeMemory(g_vk.dev, mem, NULL);
+    rel(hb);
+}
+
+void vk_ahb_probe(void) {
+    if (!g_vk.mem_ahb || getenv("LARECOMP_NO_AHB_PROBE")) return;
+    void *lib = dlopen("libandroid.so", RTLD_NOW);
+    if (!lib) { LOG("[ahb] libandroid.so not loadable\n"); return; }
+    LOG("[ahb] Android hardware buffers as game memory (a test: nothing of it is used by the game)\n");
+    probe_ahb_size(lib, PROBE_SIZE, true);
+    long pages = sysconf(_SC_PHYS_PAGES), psz = sysconf(_SC_PAGESIZE);
+    uint64_t ram = pages > 0 && psz > 0 ? (uint64_t)pages * (uint64_t)psz : 0;
+    if (ram < (7ull << 30)) { LOG("[ahb] larger sizes skipped: %llu MB of RAM\n", (unsigned long long)(ram >> 20)); return; }
+    static const unsigned sizes_mb[] = {512, 1024, 2048, 3072};
+    for (unsigned i = 0; i < sizeof sizes_mb / sizeof *sizes_mb; i++) probe_ahb_size(lib, (uint64_t)sizes_mb[i] << 20, false);
+}
 #endif
